# Base URL of the Flask export backend (no trailing slash).
# Leave unset for local development — the app falls back to http://localhost:3001.
# In Vercel, set this to the deployed backend URL, e.g. https://quote-gen-be.vercel.app
VITE_API_BASE=

# U-series feature flags — comma-separated allow-list, read once at build
# time (src/lib/featureFlags.js). DEFAULT-OFF: unset or empty means every
# U-series screen is hidden and unmounted, on localhost and on Vercel alike.
# Flipping one needs a rebuild — there is no runtime toggle.
#   u1_producing_plants   — the read-only Producing Plants screen
#   u1_customer_families  — the read-only Customer Families screen (also
#                            requires the caller's own read_party_master
#                            capability; the flag alone does not grant it)
# Example to turn both on locally: VITE_FEATURE_FLAGS=u1_producing_plants,u1_customer_families
VITE_FEATURE_FLAGS=
